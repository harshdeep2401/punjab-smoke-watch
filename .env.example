# Copy this file to .env and fill it in. Never commit .env.
# The app runs without it (saved briefs only). To run the AI agents live, fill in all three LLM_ lines.

# ---- Option A: Gemini free tier. Get a key at https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash

# ---- Option B: Ollama (local). Comment out the three lines above and use these instead.
# The key can be any text, but it must not be empty. Use a model that supports tool calling.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:14b

# ---- Only needed to re-fetch fire data (pipeline ingest / forward-test), not to run the app.
# Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
